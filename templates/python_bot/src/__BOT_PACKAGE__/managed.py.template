"""Managed/standalone hooks with durable local update processing."""
from __future__ import annotations
import argparse
import json
from pathlib import Path
import queue
import sqlite3
import threading
import time
import urllib.error
import urllib.request

SCHEMA = 1
POLL_DEADLINE_SECONDS = 30


class PollDeadlineExceeded(Exception):pass


def single_poll(call,stop,deadline_seconds=30):
    """One bounded poll; a timed-out daemon is followed only by worker exit."""
    results=queue.Queue(maxsize=1)
    def perform():
        try:results.put((True,call()))
        except BaseException as error:results.put((False,error))
    threading.Thread(target=perform,daemon=True,name='__BOT_ID__-telegram-poll').start()
    deadline=time.monotonic()+deadline_seconds
    while True:
        if stop.is_set():raise InterruptedError('Stop requested.')
        remaining=deadline-time.monotonic()
        if remaining<=0:raise PollDeadlineExceeded('Overall polling deadline exceeded; exit this worker before any subsequent poll.')
        try:success,value=results.get(timeout=min(.2,remaining));break
        except queue.Empty:continue
    if not success:raise value
    return value


def initialize(directory):
    """Only explicit new-project creation calls this function."""
    root=Path(directory)
    root.mkdir(parents=True,exist_ok=False)
    db=sqlite3.connect(root/'bot.sqlite3')
    try:
        db.executescript('''PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL;
        CREATE TABLE processed_updates(id INTEGER PRIMARY KEY);
        CREATE TABLE metadata(key TEXT PRIMARY KEY,value TEXT NOT NULL);
        CREATE TABLE local_effects(update_id INTEGER PRIMARY KEY,kind TEXT NOT NULL);
        INSERT INTO metadata VALUES('schema','1');''')
        db.commit()
    finally:db.close()
    (root/'namespace.json').write_text(json.dumps({'schema':SCHEMA,'bot_id':'__BOT_ID__','template':'1.0.0'}),encoding='utf-8')


def apply_local_update(db,update):
    """Replace with application-owned local behavior on this same transaction."""
    kind='callback' if 'callback_query' in update else 'message'
    db.execute('INSERT INTO local_effects VALUES(?,?)',(update['update_id'],kind))


def process_update(db,update,handler=apply_local_update):
    db.execute('BEGIN IMMEDIATE')
    try:
        update_id=int(update['update_id'])
        if db.execute('SELECT 1 FROM processed_updates WHERE id=?',(update_id,)).fetchone():
            db.rollback();return False
        handler(db,update)
        db.execute('INSERT INTO processed_updates VALUES(?)',(update_id,))
        db.commit();return True
    except BaseException:
        db.rollback();raise


def run(client,manifest):
    root=Path(manifest['data_dir'])
    if not (root/'namespace.json').is_file() or not (root/'bot.sqlite3').is_file():
        raise ValueError('Expected bot state is missing. Restore it; startup never initializes it.')
    if 'polling' not in manifest.get('capabilities',['polling']):
        client.emit('failure',category='configuration',message='Polling is not declared for this project. Add only explicitly requested capabilities and jobs.')
        return
    db=sqlite3.connect((root/'bot.sqlite3').as_uri()+'?mode=rw',uri=True,isolation_level=None)
    token=client.bootstrap['token']
    try:
        if db.execute('PRAGMA quick_check').fetchone()[0]!='ok':raise ValueError('Bot state failed integrity validation.')
        row=db.execute("SELECT value FROM metadata WHERE key='schema'").fetchone()
        if row is None or row[0]!='1':raise ValueError('Unsupported bot state schema.')
        client.ready()
        delay=2
        while not client.stop.is_set():
            last=db.execute('SELECT COALESCE(MAX(id),-1) FROM processed_updates').fetchone()[0]
            payload=json.dumps({'offset':last+1,'timeout':5,'allowed_updates':['message','callback_query']}).encode()
            request=urllib.request.Request('https://api.telegram.org/bot'+token+'/getUpdates',data=payload,headers={'Content-Type':'application/json'})
            try:
                def transport():
                    with urllib.request.urlopen(request,timeout=30) as response:return json.load(response)
                result=single_poll(transport,client.stop,deadline_seconds=POLL_DEADLINE_SECONDS)
                if not result.get('ok'):
                    code=result.get('error_code')
                    if code in (401,409):
                        client.emit('failure',category='credentials' if code==401 else 'conflict',message='Telegram rejected polling; review credentials or other instances.')
                        return
                    raise OSError('Telegram polling temporarily unavailable.')
                client.progress(poll_ok=True)
                for update in result['result']:
                    if client.stop.is_set():break
                    process_update(db,update)
                    client.progress()
                delay=2
            except PollDeadlineExceeded:
                client.emit('failure',category='unexpected',message='Polling exceeded its overall 30-second deadline; worker exits without a second active poll.')
                return 2
            except InterruptedError:
                client.emit('completed',reason='cooperative stop')
                return 0
            except urllib.error.HTTPError as error:
                if error.code in (401,409):
                    client.emit('failure',category='credentials' if error.code==401 else 'conflict',message='Telegram rejected polling; review credentials or other instances.')
                    return
                client.progress(connection='Disconnected');client.stop.wait(delay);delay=min(delay*2,30)
            except (OSError,urllib.error.URLError):
                client.progress(connection='Disconnected');client.stop.wait(delay);delay=min(delay*2,30)
        client.emit('completed',reason='cooperative stop')
    finally:db.close()


def main():
    parser=argparse.ArgumentParser()
    parser.add_argument('--initialize',type=Path)
    args,rest=parser.parse_known_args()
    if args.initialize:
        if rest:parser.error('Unexpected arguments for explicit initialization.')
        initialize(args.initialize);return
    from bot_center_runtime.runner import main as standalone
    return standalone(rest)


if __name__=='__main__':main()
